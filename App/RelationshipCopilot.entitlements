<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- 移除 aps-environment：仓库内没有任何远程推送实现
         （无 registerForRemoteNotifications、无服务端推送端点）。
         声明 push 能力属于"声明了做不到的能力"，且硬编码为 development
         会让生产构建的推送必然失败。本地通知不需要该 entitlement。 -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.relationshipcopilot.app</string>
    </array>
</dict>
</plist>
