<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>关系副驾</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>zh-Hans</string>
		<string>en</string>
	</array>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSFaceIDUsageDescription</key>
	<string>用于快速解锁你保存在本机的关系记录。</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>用于录制你们的对话，以便生成关系分析。录音只保存在本机，分析完成后会立即删除。</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>用于从相册选择一张照片作为人物头像。照片只保存在本机，不会上传。</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>用于把录音转成文字以生成分析。优先使用设备端识别；若设备不支持，音频会交由系统语音识别服务处理。</string>
	<key>RCAllowBetaSkipAuth</key>
	<true/>
	<key>RCAllowDirectKeyInDebug</key>
	<true/>
	<key>RCDirectBaseURL</key>
	<string>https://www.sophnet.com/api/open-apis/v1/chat/completions</string>
	<key>RCDirectModelName</key>
	<string>DeepSeek-V4.1-Flash-1017</string>
	<key>RCProxyBaseURL</key>
	<string></string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
